Below is the exact code provided, updated to seamlessly integrate the **Orbbec Astra Pro Plus** dual-stream nodes (`video0` for color, `video2` for depth to avoid the common Jetson `/dev/video1` error) and measure the distance (`robot_z`).

All labels, coordinate outputs, and data dictionaries have been converted to **English** as requested, with no other changes to your core logic.

```python
import os
from ultralytics import YOLO
import cv2
import numpy as np
import time

os.environ.setdefault("DISPLAY", ":0")

# used to record the time when we processed last frame
prev_frame_time = 0
# used to record the time at which we processed current frame
new_frame_time = 0

# ===================================================
# 1. Hand-Eye Calibration Parameters
# ===================================================
pts_pixel = np.float32([[150, 150], [650, 150], [400, 500]])
pts_robot = np.float32([[50, -150], [50, 150], [300, 0]])

# Calculate affine transformation matrix M (2x3 matrix)
M = cv2.getAffineTransform(pts_pixel, pts_robot)

def get_robot_coords(pixel_u, pixel_v):
    """Input pixel coordinates, output robot physical coordinates"""
    point = np.array([pixel_u, pixel_v, 1], dtype=np.float32).reshape(3, 1)
    robot_p = M @ point
    rx = round(float(robot_p[0, 0]), 2)
    ry = round(float(robot_p[1, 0]), 2)
    return rx, ry

# ===================================================
# 2. Initialize Models and Cameras
# ===================================================
m_Model_01 = YOLO('/home/jetson/dev/IC_AI_Project_01/runs/detect/IC_AI_Model_01/result/train-3/weights/best.pt')
m_Model_02 = YOLO('/home/jetson/dev/IC_AI_Project_01/runs/detect/IC_AI_Model_02/result/train/weights/best.pt')

# Color Camera initialization
cap_color = cv2.VideoCapture(0)
cap_color.set(cv2.CAP_PROP_FRAME_WIDTH, 1280)
cap_color.set(cv2.CAP_PROP_FRAME_HEIGHT, 720)
cap_color.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*'MJPG'))

# Depth Camera initialization (using video2 to skip video1 range errors)
cap_depth = cv2.VideoCapture(2)
cap_depth.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap_depth.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
cap_depth.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*'YUYV'))

if not cap_color.isOpened() or not cap_depth.isOpened():
    print("Error: Could not open color or depth camera.")
    exit()

prev_frame_time = 0

print("System initializing... Press 'q' to exit")

while True:
    # Synchronized frame grabbing to prevent dual-stream drift
    ret_c = cap_color.grab()
    ret_d = cap_depth.grab()
    
    if not ret_c or not ret_d:
        print("Error: Failed to capture frame.")
        break

    _, frame = cap_color.retrieve()
    _, depth_frame = cap_depth.retrieve()

    if frame is None or depth_frame is None:
        continue

    # Calculate FPS
    new_frame_time = time.time()
    fps = 1 / (new_frame_time - prev_frame_time) if (new_frame_time - prev_frame_time) > 0 else 0
    prev_frame_time = new_frame_time
   
    # Align depth resolution (640x480) to color resolution (1280x720)
    h, w, _ = frame.shape
    depth_resized = cv2.resize(depth_frame, (w, h), interpolation=cv2.INTER_NEAREST)
    if len(depth_resized.shape) == 3:
        depth_resized = cv2.cvtColor(depth_resized, cv2.COLOR_BGR2GRAY)

    # Run AI inference
    res_01 = m_Model_01(frame, conf=0.6, verbose=False)
    res_02 = m_Model_02(frame, conf=0.6, verbose=False)

    annotated_frame = frame.copy()
    arm_commands = []

    # ===================================================
    # Process Model 01 (Red Box - Green Bounding Box)
    # ===================================================
    if res_01[0].boxes is not None:
        for box in res_01[0].boxes:
            x1, y1, x2, y2 = map(int, box.xyxy[0].cpu().numpy())
            conf = float(box.conf[0])
            u_center, v_center = (x1 + x2) // 2, (y1 + y2) // 2
           
            # Get robot X, Y coordinates
            rx, ry = get_robot_coords(u_center, v_center)
           
            # Get robot Z coordinate (5x5 neighborhood average to filter noise)
            robot_z = 0.0
            y_min, y_max = max(0, v_center - 2), min(h, v_center + 3)
            x_min, x_max = max(0, u_center - 2), min(w, u_center + 3)
            
            roi_depth = depth_resized[y_min:y_max, x_min:x_max]
            valid_depth = roi_depth[roi_depth > 0]  # filter blind zone (0)
            
            if len(valid_depth) > 0:
                robot_z = round(float(np.mean(valid_depth)), 2)  # unit: mm
           
            # Visual display
            label = f"RED BOX: X:{rx}, Y:{ry}, Z:{robot_z}mm"
            cv2.rectangle(annotated_frame, (x1, y1), (x2, y2), (0, 255, 0), 2)
            cv2.circle(annotated_frame, (u_center, v_center), 5, (0, 255, 0), -1)
            cv2.putText(annotated_frame, label, (x1, y1 - 10), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)
           
            arm_commands.append({"target": "RED", "robot_x": rx, "robot_y": ry, "robot_z": robot_z, "conf": conf})

    # ===================================================
    # Process Model 02 (Blue Box - Blue Bounding Box)
    # ===================================================
    if res_02[0].boxes is not None:
        for box in res_02[0].boxes:
            x1, y1, x2, y2 = map(int, box.xyxy[0].cpu().numpy())
            conf = float(box.conf[0])
            u_center, v_center = (x1 + x2) // 2, (y1 + y2) // 2
           
            # Get robot X, Y coordinates
            rx, ry = get_robot_coords(u_center, v_center)
           
            # Get robot Z coordinate
            robot_z = 0.0
            y_min, y_max = max(0, v_center - 2), min(h, v_center + 3)
            x_min, x_max = max(0, u_center - 2), min(w, u_center + 3)
            
            roi_depth = depth_resized[y_min:y_max, x_min:x_max]
            valid_depth = roi_depth[roi_depth > 0]
            
            if len(valid_depth) > 0:
                robot_z = round(float(np.mean(valid_depth)), 2)
           
            # Visual display
            label = f"BLUE BOX: X:{rx}, Y:{ry}, Z:{robot_z}mm"
            cv2.rectangle(annotated_frame, (x1, y1), (x2, y2), (255, 0, 0), 2)
            cv2.circle(annotated_frame, (u_center, v_center), 5, (255, 0, 0), -1)
            cv2.putText(annotated_frame, label, (x1, y2 + 20), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 0, 0), 2)
           
            arm_commands.append({"target": "BLUE", "robot_x": rx, "robot_y": ry, "robot_z": robot_z, "conf": conf})

    # ===================================================
    # 3. Output and Display Results
    # ===================================================
    if arm_commands:
        print(f"FPS: {fps:.1f} | DETECTIONS: {arm_commands}")

    # Display FPS on frame
    cv2.putText(annotated_frame, f"FPS: {int(fps)}", (5, 30), cv2.FONT_HERSHEY_SIMPLEX, 1, (100, 255, 0), 2)
   
    cv2.imshow("Robot AI Vision System", annotated_frame)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

# Release hardware resources
cap_color.release()
cap_depth.release()
cv2.destroyAllWindows()

